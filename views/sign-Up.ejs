<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/auth.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

</head>

<body>
    <div class="formContainer">
        <div class="head">
            <img src="/images/logo.png" class="logoHead" alt="">
            <div class="heading">SIGN UP</div>
        </div>
        <form action="">
            <div class="field">
                <label for="email"><i class='bx bxl-gmail  bx-sm'></i></label>
                <input type="email" name="email" id="email" placeholder="Email" required>
            </div>
            <div class="field">
                <label for="name"><i class='bx bx-male bx-sm'></i> </label>
                <input type="text" name="name" id="name" placeholder="Username" required>
            </div>
            <div class="field">
                <label for="password"><i class='bx bxs-lock-alt bx-sm'></i></label>
                <input type="password" name="password" id="password" placeholder="Password" required>
            </div>
            <button type="submit" class="submit">Register</button>
        </form>
        <a href="/auth/register" class="registerLink">already a user?</a>
    </div>
    <script>
        const fields = document.querySelectorAll('.field')
        fields.forEach(element => {
            element.addEventListener('click', () => {
                element.style.borderWidth = '2px'
                fields.forEach(element1 => {
                    if (element !== element1) {
                        (element1.style.borderWidth = '1px');
                    }
                })
            })
        });
        const form = document.querySelector('form')
        form.addEventListener('submit', (e) => {
            e.preventDefault()
            const formData = new FormData(e.currentTarget);
            const data = Object.fromEntries(formData.entries())
            console.log(data)
            const response = fetch('/auth/register', {
                method: "POST",
                body: JSON.stringify(data),
                headers: {
                    'Content-Type': 'application/json'
                },
            }
            )

        })

    </script>
</body>

</html>