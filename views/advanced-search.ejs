<!doctype html>

<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/added.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/stylesheets/advancedSearch.css">
    </style>
</head>

<body>
    <%- include('navbar');%>
        <div class="filterPage">
            <input type="text" class="search-box-advanced" placeholder="search ">
            <h2 class="fPageHeading">Filter</h2>
            <div>
                <div class="fHeading">
                    season
                </div>
                <button class="options season" onclick="selectSeason(this)">
                    spring
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    summer
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    fall
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    winter
                </button>
            </div>
            <div>
                <div class="fHeading">
                    age rating
                </div>
                <button class="options" onclick="selectAgeRating(this)">
                    G
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    PG
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    R
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    R18
                </button>
            </div>
            <div>
                <div class="fHeading">
                    genre
                </div>
                <% genres.data.map(genre=> { %>
                    <button class="options" onclick="selectGenre(this) ">
                        <%= genre %>
                    </button>

                    <% }) %>

            </div>
            <div>
                <div class="fHeading">
                    year
                </div>
                <select id='date-dropdown'>
                </select>
            </div>
            <button class="search-ok btn" onclick="searchAdvanced()">
                Search
            </button>
        </div>

        <script src="/javascript/advancedSearch.js">

        </script>
        <script src="/javascript/main.js"></script>



</body>

</html>