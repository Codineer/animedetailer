<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/searchp.css">
    <link rel="stylesheet" href="/stylesheets/added.css">
    <!-- boxicons -->
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css"> -->
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/stylesheets/advancedSearch.css">

</head>

<body>
    <%- include('navbar');%>

        <h1 class="search-resuts-heading">Search Results</h1>
        <div class="searchPage">

            <h2 class="fPageHeading">Filter</h2>
            <div>
                <div class="fHeading">
                    season
                </div>
                <button class="options season" onclick="selectSeason(this)">
                    spring
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    summer
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    fall
                </button>
                <button class="options season" onclick="selectSeason(this)">
                    winter
                </button>
            </div>
            <div>
                <div class="fHeading">
                    age rating
                </div>
                <button class="options" onclick="selectAgeRating(this)">
                    G
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    PG
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    R
                </button>
                <button class="options" onclick="selectAgeRating(this)">
                    R18
                </button>
            </div>
            <div>
                <div class="fHeading">
                    genre
                </div>
                <% genres.data.map(genre=> { %>
                    <button class="options" onclick="selectGenre(this) ">
                        <%= genre %>
                    </button>

                    <% }) %>

            </div>
            <div>
                <div class="fHeading">
                    year
                </div>
                <select id='date-dropdown'>
                </select>
            </div>
            <button class="search-ok btn" onclick="searchAdvanced()">
                Search
            </button>
        </div>
        <div class="search-results">
            <% SearchResults.data.map(anime=> { %>
                <a href="/anime/<%=anime.id %>">

                    <div class="card search-card">
                        <div class="card-img-div">
                            <img src=<%=anime.attributes.posterImage?.original || anime.attributes.coverImage?.original
                                %>>
                            <div class="card-avg-rating">
                                <%= Math.floor(anime.attributes.averageRating) || 'N/A' %>
                            </div>
                        </div>

                        <div class="card-age-rating">
                            <%= anime.attributes.ageRatingGuide %>
                        </div>
                        <!-- add javascript funtion to convert float to int -->
                        <h1>
                            <%= anime.attributes.titles?.en || anime.attributes.titles?.en_us ||
                                anime.attributes.titles?.en_jp || anime.attributes.titles?.ja_jp || 'N/A' %>
                        </h1>
                        <div class="ani-type-epi">
                            <%= anime.attributes?.showType || 'N/A' %> &sdot; <%= anime.attributes?.episodeCount
                                    || 'N/A' %>
                                    ep
                        </div>
                    </div>
                </a>
                <% }) %>




        </div>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <script src="/javascript/main.js">

        </script>
        <script src="/javascript/advancedSearchResult.js"></script>
        <script>
            changeValue("<%= searchQuery %>")

        </script>


</body>

</html>