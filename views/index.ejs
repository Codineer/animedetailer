<!doctype html>

<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/added.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="/stylesheets/searchp.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

</head>

<body>
    <%- include('navbar');%>

        <section class="home swiper" id="home">

            <div class="swiper-wrapper ">
                <% TrendingAnimes.data.map(anime=> { %>
                    <div style="display: flex;" class="swiper-slide container">

                        <img src=<%=anime.attributes.coverImage?.original || anime.attributes.posterImage?.original %>>
                        <div class="home-text">
                            <span>
                                <%= anime.attributes.titles.en %>
                            </span>
                            <h1>
                                <%= anime.attributes.titles?.ja_jp || anime.attributes.titles?.en_jp ||
                                    anime.attributes.titles?.en_us || "Title not available" %>
                                    <br>
                                    <%= anime.attributes.ageRatingGuide %>
                            </h1>
                            <a href="/anime/<%=anime.id %>" class="btn">Explore</a>
                        </div>
                    </div>
                    <% }) %>
                        <div class="swiper-pagination"></div>
            </div>

        </section>
        <section class="pop-movies" id="pop-movies">
            <h2 class="heading">
                Most popular
            </h2>
            <div class="containermov">
                <% PopularAnimes.data.map(anime=> { %>
                    <a href="/anime/<%=anime.id %>">
                        <div class="card search-card">
                            <div class="card-img-div">
                                <img src=<%=anime.attributes.posterImage?.original ||
                                    anime.attributes.coverImage?.original %>>
                                <div class="card-avg-rating">
                                    <%= Math.floor(anime.attributes.averageRating) || 'N/A' %>
                                </div>
                            </div>

                            <div class="card-age-rating">
                                <%= anime.attributes.ageRatingGuide %>
                            </div>
                            <!-- add javascript funtion to convert float to int -->
                            <h1 class="titleh1">
                                <%= anime.attributes.titles?.en || anime.attributes.titles?.en_us ||
                                    anime.attributes.titles?.en_jp || anime.attributes.titles?.ja_jp || 'N/A' %>
                            </h1>
                            <div class="ani-type-epi">
                                <%= anime.attributes?.showType || 'N/A' %> &sdot; <%= anime.attributes?.episodeCount
                                        || 'N/A' %>
                                        ep
                            </div>
                        </div>

                    </a>
                    <% }) %>

            </div>


        </section>
        <section class="trengen">
            <div class="trending">
                <h2 class="heading">
                    Trending
                </h2>
                <% TrendingAnimes.data.map(anime=> { %>
                    <a href="/anime/<%=anime.id %>">

                        <div class="anime-card">
                            <img class="anime-image" src=<%=anime.attributes.posterImage.small %> >
                            <div class="anime-info">
                                <div class="anime-title">
                                    <%= anime.attributes.titles?.en || anime.attributes.titles?.en_us ||
                                        anime.attributes.titles?.en_jp || anime.attributes.titles?.ja_jp ||
                                        anime.attributes?.slug || 'N/A' %>
                                </div>
                                <div class="anime-stats">
                                    <span class="stat green">CC <%= anime.attributes.episodeCount %></span>
                                    <span class="stat blue">🎤 <%= anime.attributes.episodeCount %></span>
                                    <span class="stat type">• <%= anime.attributes.subtype %></span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% }) %>



            </div>
            <div class="Top-airing">
                <h2 class="heading">
                    Favourite
                </h2>
                <% favoritesAnimes.data.map(anime=> { %>
                    <a href="/anime/<%=anime.id %>">
                        <div class="anime-card">
                            <img class="anime-image" src=<%=anime.attributes.posterImage.small %> >
                            <div class="anime-info">
                                <div class="anime-title">
                                    <%= anime.attributes.titles?.en || anime.attributes.titles?.en_us ||
                                        anime.attributes.titles?.en_jp || anime.attributes.titles?.ja_jp ||
                                        anime.attributes?.slug || 'N/A' %>
                                </div>
                                <div class="anime-stats">
                                    <span class="stat green">CC <%= anime.attributes.episodeCount %></span>
                                    <span class="stat blue">🎤 <%= anime.attributes.episodeCount %></span>
                                    <span class="stat type">• <%= anime.attributes.subtype %></span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% }) %>


            </div>
            <div class="genre">
                <h2 class="heading">
                    Genre
                </h2>
                <div class="genre-card">
                    <% genres.data.map(genre=> { %>
                        <div class="genre-tag">
                            <a href="/anime/genre/<%= genre.attributes.name %>">
                                <%= genre.attributes.name %>

                            </a>
                        </div>

                        <% }) %>
                </div>
            </div>
        </section>
        <script>
            const styleSheet = document.styleSheets[0];
            styleSheet.insertRule(`
 nav ul .home-active::after {
    width: 100%;
}

`, styleSheet.cssRules.length);
            styleSheet.insertRule(`
    .category-active::after {
    width: 0%;

}
 .popular-active::after {
    width: 0%;
  }
`, styleSheet.cssRules.length);
        </script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

        <script src="/javascript/main.js"></script>

</body>

</html>