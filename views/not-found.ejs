            gap: 5px;
        }

        .nbtn img {
            width: 20px;
            height: 20px;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <img src="/images/notfound.png" alt="">
    <h1>
        404 Error <br>
        Oops! We can't find this page.
    </h1>
    <button class="btn nbtn">

        <a href="/">
            <img src="/images/back.svg" alt="">

        </a>
        <a href="/">
            back to homepage
        </a>
    </button>
</body>

</html>