<!doctype html>

<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/added.css">
    <link rel="stylesheet" href="/stylesheets/animep.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

</head>

<body>
    <%- include('../navbar');%>

        <div class="anime-page">
            <h1 class="anime-page-heading">
                <%= animedata.data.attributes.titles?.en || animedata.data.attributes.titles?.en_us ||
                    animedata.data.attributes.titles?.en_jp ||animedata.data.attributes.titles?.ja_jp ||
                    animedata.data.attributes?.slug || 'N/A' %>
            </h1>
            <div class="anime-main">
                <img class="anime-main-img" src="<%= animedata.data.attributes.posterImage.large %>" alt="">
                <p class="anime-main-synopsis">
                    <%= animedata.data.attributes.synopsis %>
                </p>
            </div>
            <div class="streamingServices">
                <% streamingServices.map(service=> { %>
                    <a target="_blank" href="<%= service.url %>">
                        <img width="60px" src="/images/streamers/<%= service.image %>" alt="">
                    </a>
                    <% }) %>
            </div>
            <div class="episvid">

                <div class="episode-details">
                    <div class="episode-info">
                        <p><strong>Episode Count:</strong>
                            <%= animedata.data.attributes.episodeCount %>
                        </p>

                        <ul>
                            <li><strong>English:</strong>
                                <%= animedata.data.attributes.titles.en %>
                            </li>
                            <li><strong>English (JP):</strong>
                                <%= animedata.data.attributes.titles.en_jp %>
                            </li>
                            <li><strong>English (US):</strong>
                                <%= animedata.data.attributes.titles.en_us %>
                            </li>
                            <li><strong>Japanese:</strong>
                                <%= animedata.data.attributes.titles.ja_jp %>
                            </li>
                        </ul>
                        <p><strong>Average Rating:</strong>
                            <%= animedata.data.attributes.averageRating %>
                        </p>
                        <p><strong>Start Date:</strong>
                            <%= animedata.data.attributes.startDate %>
                        </p>
                        <p><strong>End Date:</strong>
                            <%= animedata.data.attributes.endDate %>
                        </p>
                        <p><strong>Age Rating:</strong>
                            <%= animedata.data.attributes.ageRating %>
                        </p>
                        <p><strong>Age Rating Guide:</strong>
                            <%= animedata.data.attributes.ageRatingGuide %>
                        </p>
                        <p><strong>Showtype:</strong>
                            <%= animedata.data.attributes.subtype %>
                        </p>
                        <p><strong>Status:</strong>
                            <%= animedata.data.attributes.status %>
                        </p>
                    </div>
                </div>


                <div class="ani-video">

                    <iframe class="ani-iframe"
                        src="https://www.youtube.com/embed/<%= animedata.data.attributes.youtubeVideoId%>"
                        title="YouTube video player" frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
            </div>




            <div class="characters-section">
                <h1 class="anime-characters-heading">
                    Characters
                </h1>
                <div class="character-collection">
                    <% animeCharacters.map(character=> { %>
                        <a href="/anime/character/<%= character.data.id %>">

                            <div class="char-card">
                                <img width="130px" height="150px"
                                    src="<%= character.data.attributes.image?.original || character.data.attributes.image?.small ||  character.data.attributes.image?.large  || character.data.attributes.image?.tiny  %>"
                                    alt="<%= character.data.attributes.name %>">
                                <p>
                                    <%= character.data.attributes.name %>
                                </p>
                            </div>

                        </a>
                        <% }) %>
                </div>
            </div>
            <div class="more-content content">
                <h2>More Content</h2>

                <dl>
                    <!-- Plot section -->
                    <a href="/anime/episodes/<%= animedata.data.id %>?name=<%= animedata.data.attributes.titles.en %>">
                        <dt>1. Episodes</dt>
                    </a>
                    <a href="<%= animedata.data.relationships.genres.links.self %>">
                        <dd>2. Genres</dd>
                    </a>
                    <a href="<%= animedata.data.relationships.categories.links.self %>">
                        <dt>3. Categories</dt>
                    </a>
                    <a href="<%= animedata.data.relationships.categories.links.self %>">
                        <dt>3. reviews</dt>
                    </a>
                </dl>
            </div>

        </div>


        <script src="/javascript/main.js"></script>
        <script src="/javascript/anime.js"></script>

</body>

</html>