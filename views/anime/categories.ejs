<!doctype html>

<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/added.css">

    <style>
        .categoriessPage {
            margin-top: 100px;
            padding: 0px 25px;

        }

        .catcard {
            background: var(--main-color);
            color: white;
            width: auto;
            border-radius: 10px;
            padding: 5px;

        }

        .categories {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
    </style>
</head>

<body>
    <%- include('../navbar');%>

        <div class="categoriessPage ">
            <h1 style="margin-bottom: 10px;">
                Categories
            </h1>
            <div class="categories">
                <% categories.data.map((category, index)=> { %>

                    <a href="">
                        <div class="catcard">
                            <a href="http://localhost:3000/anime/categories/<%=category.attributes.slug %>">
                                <%=category.attributes.title %>
                            </a>
                        </div>
                    </a>
                    <% }) %>
            </div>

        </div>
        <script>
            const styleSheet = document.styleSheets[0];

            styleSheet.insertRule(`
  .category-active::after {
    width: 100%;
  }
`, styleSheet.cssRules.length);
            styleSheet.insertRule(`
 nav ul .home-active::after {
    width: 0%;
}
`, styleSheet.cssRules.length);
        </script>
        <script src="/javascript/main.js"></script>
        <script src="/javascript/anime.js"></script>

</body>

</html>